FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY patches ./patches
RUN npm ci --ignore-scripts && npx patch-package && npm prune --omit=dev --ignore-scripts && npm cache clean --force
COPY build ./build
COPY scripts/start-web.mjs scripts/start-web.mjs
COPY scripts/web-cloud/runner.mjs scripts/web-cloud/runner.mjs
RUN mkdir -p /data && chown 10001:10001 /data
USER 10001:10001
EXPOSE 3080
CMD ["node", "scripts/web-cloud/runner.mjs"]
